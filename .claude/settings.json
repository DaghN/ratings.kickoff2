{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.cursor/rules/kool-workspace.mdc\"",
            "timeout": 10,
            "statusMessage": "Loading kool-workspace rule"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git blame *)",
      "Bash(git grep *)",
      "Bash(git remote -v)",
      "Bash(git stash list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git pull --ff-only *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh auth status *)",

      "Bash(/c/laragon/bin/php/*/php.exe *)",
      "Bash(C:/laragon/bin/php/*/php.exe *)",
      "Bash(/c/laragon/bin/mysql/*/bin/mysql.exe *)",
      "Bash(C:/laragon/bin/mysql/*/bin/mysql.exe *)",
      "Bash(/c/laragon/bin/mysql/*/bin/mysqladmin.exe *)",
      "Bash(C:/laragon/bin/mysql/*/bin/mysqladmin.exe *)",
      "Bash(/c/laragon/bin/mysql/*/bin/mysqldump.exe *)",
      "Bash(C:/laragon/bin/mysql/*/bin/mysqldump.exe *)",

      "Bash(python scripts*)",
      "Bash(python -m scripts*)",

      "Bash(powershell -ExecutionPolicy Bypass -File scripts*)",
      "Bash(powershell -ExecutionPolicy Bypass -File schema*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts*)",

      "Bash(curl * http://ratingskickoff.test*)",
      "Bash(curl * http://work.ratingskickoff.test*)",

      "Read(//c/laragon/**)",

      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run view *)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File scripts*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File schema*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard *)"
    ]
  }
}
